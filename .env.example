# Public canonical URL. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set true to expose the built-in demo report while Meta review is pending.
NEXT_PUBLIC_DEMO_MODE=true

# Meta Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=

# Supabase (server-side only; NEVER prefix the service role key with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini Developer API (optional: app has deterministic fallback copy if omitted)
# gemini-2.5-flash-lite currently has a free tier; usage is still subject to Google rate limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
